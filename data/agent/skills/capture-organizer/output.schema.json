{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capture classification proposal",
  "type": "object",
  "required": [
    "segments"
  ],
  "properties": {
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "text",
          "kind",
          "summary"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "kind": {
            "enum": [
              "spark_card",
              "question_card",
              "task_card",
              "care_card",
              "weekly_card"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "health_category": {
            "enum": [
              null,
              "nutrition",
              "hydration",
              "exercise",
              "sleep",
              "mood",
              "learning",
              "mindfulness",
              "symptom",
              "travel"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "related_card_ids": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "presentation": {
            "type": "object",
            "required": [
              "blocks"
            ],
            "properties": {
              "blocks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "title",
                        "text"
                      ],
                      "properties": {
                        "type": {
                          "const": "paragraph"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 40
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1500
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "title",
                        "items"
                      ],
                      "properties": {
                        "type": {
                          "const": "list"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 40
                        },
                        "items": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 8,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 300
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
