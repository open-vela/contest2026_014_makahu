{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "answer"
      ],
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "unanswered": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "required": [
        "unanswered"
      ],
      "properties": {
        "unanswered": {
          "const": true
        },
        "reason": {
          "type": "string"
        }
      }
    }
  ]
}
