@@ -745,7 +745,6 @@
   FAR struct littlefs_file_s *priv;
   struct littlefs_attr_s attr;
   FAR struct inode *inode;
-  FAR char *path;
   int ret;
 
   memset(buf, 0, sizeof(*buf));
@@ -756,29 +755,14 @@
   inode = filep->f_inode;
   fs    = inode->i_private;
 
-  /* Call LFS to get file size */
-
-  path = lib_get_tempbuffer(PATH_MAX);
-  if (path == NULL)
-    {
-      return -ENOMEM;
-    }
-
-  /* Path reconstruction reads directory metadata and the open-file list.
-   * Hold the same lock used by rename, create and attribute updates. */
-
-  ret = nxmutex_lock(&fs->lock);
-  if (ret < 0)
-    {
-      lib_put_tempbuffer(path);
