   FAR struct inode *inode;
-  FAR char *path;
   int ret;
 
   /* Recover our private data from the struct file instance */
@@ -838,33 +820,16 @@
   inode = filep->f_inode;
   fs    = inode->i_private;
 
-  path = lib_get_tempbuffer(PATH_MAX);
-  if (path == NULL)
-    {
-      return -ENOMEM;
-    }
-
-  /* Call LFS to get file size */
-
-  /* Path reconstruction reads directory metadata and the open-file list.
-   * Hold the same lock used by rename, create and attribute updates. */
-
-  ret = nxmutex_lock(&fs->lock);
-  if (ret < 0)
-    {
-      lib_put_tempbuffer(path);
-      return ret;
-    }
-
-  ret = littlefs_convert_result(lfs_file_path(&fs->lfs, &priv->file, path,
-                                              PATH_MAX));
-  if (ret < 0)
-    {
-      goto errout;
-    }
-
-  ret = littlefs_convert_result(lfs_getattr(&fs->lfs, path, 0, &attr,
-                                            sizeof(attr)));
+  /* Keep the filesystem lock around handle-based metadata access and update. */
+
+  ret = nxmutex_lock(&fs->lock);
+  if (ret < 0)
