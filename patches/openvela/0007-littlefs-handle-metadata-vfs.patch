+  ret = littlefs_convert_result(lfs_file_setattr(&fs->lfs, &priv->file, 0,
+                                                 &attr, sizeof(attr)));
   if (ret < 0)
     {
       goto errout;
     }
 
 errout:
-  lib_put_tempbuffer(path);
   nxmutex_unlock(&fs->lock);
   return ret;
 }
