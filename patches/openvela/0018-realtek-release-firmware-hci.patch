+static int hci_send_recv(FAR struct file *filep, unsigned char *command,
+                         size_t count, size_t capacity)
+{
+  uint8_t opcode[2] = {command[1], command[2]};
+  int ret = hci_send(filep, command, count);
+  if (ret < 0) return ret;
+  ret = hci_recv(filep, command, 1);
+  if (ret < 0) return ret;
+  if (command[0] != HCI_EVENT_PKT) return -EPROTO;
+  ret = hci_recv(filep, command + 1, sizeof(struct bt_hci_evt_hdr));
+  if (ret < 0) return ret;
+  if (command[1] != 0x0e || command[2] < 4 ||
+      (size_t)command[2] + 3 > capacity) return -EPROTO;
+  ret = hci_recv(filep, command + 3, command[2]);
+  if (ret < 0) return ret;
+  if (command[4] != opcode[0] || command[5] != opcode[1] ||
+      command[6] != 0) return -EPROTO;
