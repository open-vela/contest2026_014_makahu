+static void bt_slip_retx_work(FAR void *arg)
+{
+  FAR struct sliphci_s *priv = arg;
+  FAR struct unack_pool_s *pool = &priv->unackpool;
+  FAR struct unack_frame_s *frame;
+  size_t i;
+
+  if (nxmutex_lock(&priv->sliplock) < 0)
+    {
+      return;
+    }
+
+  if (priv->linkstate == BT_SLIP_ACTIVE)
+    {
+      /* Replay in place with the original sequence.  Removing/re-enqueuing
+       * here lets the controller discard retransmissions as new packets. */
+      for (i = 0; i < pool->size; i++)
+        {
+          frame = (FAR struct unack_frame_s *)
+            pool->buf[(pool->end + i) % CONFIG_BLUETOOTH_SLIP_TXWIN];
+          bt_slip_send_packet(priv, frame->type, frame->data,
+                              frame->pktlen, frame->seq);
+        }
+
+      if (pool->size)
+        {
+          work_queue(HPWORK, &priv->retxworker, bt_slip_retx_work,
+                     priv, BT_SLIP_RTX_TIMEOUT);
+        }
+    }
+
+  nxmutex_unlock(&priv->sliplock);
 }
 
