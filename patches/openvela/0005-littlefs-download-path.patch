 +
-+    if (lfs_pair_cmp(lfs->root, dir->pair) != 0) {
-+        tag = lfs_fs_parent(lfs, dir->pair, &parent);
++    // A split directory's continuation pair has no parent name entry.
++    // Locate its head before resolving the parent; keep the original pair
++    // and id below to look up this file's own name.
++    lfs_mdir_t head = *dir;
++    while (lfs_pair_cmp(lfs->root, head.pair) != 0) {
++        tag = lfs_fs_parent(lfs, head.pair, &parent);
++        if (tag == LFS_ERR_NOENT) {
++            lfs_mdir_t predecessor;
++            err = lfs_fs_pred(lfs, head.pair, &predecessor);
++            if (err) return err;
++            if (!predecessor.split) return LFS_ERR_NOENT;
++            head = predecessor;
++            continue;
++        }
 +        if (tag < 0) {
 +            return tag;
 +        }
