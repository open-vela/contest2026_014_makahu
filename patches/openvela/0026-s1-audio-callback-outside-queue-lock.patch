+static int record_read_failed(FAR struct sunxi_dev_s *priv,
+                              FAR struct ap_buffer_s *apb, int error)
+{
+	bool stopping = !priv->running;
+	priv->running = false;
+	apb->nbytes = 0;
+	syslog(stopping ? LOG_INFO : LOG_ERR, "pcm read ended: %d\n", error);
+	/* A removed buffer must be returned even when STOP cancels the read.
+	 * Otherwise the upper tail never catches the application head at close. */
+#ifdef CONFIG_AUDIO_MULTI_SESSION
+	if (!stopping)
+		priv->dev.upper(priv->dev.priv, AUDIO_CALLBACK_IOERR, apb, -error, NULL);
+	priv->dev.upper(priv->dev.priv, AUDIO_CALLBACK_DEQUEUE, apb, -error, NULL);
+#else
+	if (!stopping)
+		priv->dev.upper(priv->dev.priv, AUDIO_CALLBACK_IOERR, apb, -error);
+	priv->dev.upper(priv->dev.priv, AUDIO_CALLBACK_DEQUEUE, apb, -error);
+#endif
+	return error;
+}
