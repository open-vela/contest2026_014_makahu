 static int ili9341_backlight(struct ili9341_lcd_s *lcd, int level)
 {
-    /* 如果有背光引脚，在这里实现控制逻辑 */
+    (void)lcd;
+#ifdef CONFIG_LCD_ILI9341_R528_PWM_BACKLIGHT
+    /* sun8iw20_pin.h maps PWM4 to PD20/function 5. Active high matches
+     * the original GPIO-high full-brightness board initialization. */
+    static bool pwm_ready;
+    struct pwm_config config;
+
+    if (level < 0 || level > CONFIG_LCD_MAXPOWER)
+    {
+        return -EINVAL;
+    }
+
+    if (!pwm_ready)
+    {
+        if (hal_pwm_init() != HAL_PWM_STATUS_OK)
+        {
+            return -EIO;
+        }
+        pwm_ready = true;
+    }
+
+    config.period_ns = 20000; /* 50 kHz; level 0 is only for explicit off. */
+    config.duty_ns = (config.period_ns * (uint32_t)level +
+                     CONFIG_LCD_MAXPOWER / 2) / CONFIG_LCD_MAXPOWER;
+    config.polarity = PWM_POLARITY_NORMAL;
+    if (hal_pwm_control(4, &config) != HAL_PWM_STATUS_OK)
+    {
+        return -EIO;
+    }
+#else
+    /* This profile only has on/off power, never advertise multilevel PWM. */
+    if (hal_gpio_set_data(LCD_BACKLIGHT_PIN, level > 0) != 0)
+    {
+        return -EIO;
+    }
+#endif
     return OK;
 }
 
